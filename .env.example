# Copy to .env and adjust. Every value below is the built-in default.

APP_ENV=development
HTTP_ADDR=:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/ssl_generator?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=10s

# How often the background sweeper re-evaluates every issued certificate's
# expiry against the thresholds below. This is the only thing left on a
# timer — there's no live TLS handshake to schedule any more, just a cheap
# scan of certificates already on file.
ALERT_SWEEP_INTERVAL=12h

# A certificate becomes "expiring", then "critical", then a last-notice alert
# this many days before notAfter. These also gate email/Teams alerts (below).
EXPIRY_WARNING_DAYS=30
EXPIRY_CRITICAL_DAYS=7
EXPIRY_FINAL_DAYS=1

# Alerting — email and/or Microsoft Teams. Fires once per state change (a
# certificate crossing a threshold), not on every sweep. Leave a channel's
# settings empty to disable just that channel; leave both empty and alerting
# logs a boot-time warning and stays fully off — nothing else about the app
# depends on it being configured.

# SMTP — leave SMTP_HOST empty to disable email alerts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated list of recipients.
ALERT_EMAIL_TO=

# Microsoft Teams incoming webhook URL — leave empty to disable Teams alerts.
TEAMS_WEBHOOK_URL=

# 32 random bytes, base64 encoded — encrypts stored private keys with AES-256-GCM.
# Generate with: openssl rand -base64 32
# Leave empty to store private keys as plaintext PEM (development only).
APP_ENCRYPTION_KEY=

# 32 random bytes, base64 encoded — signs the short-lived "password verified,
# awaiting MFA" token. Required once any account exists; `make env` generates
# one automatically.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# How long a signed-in session survives without activity, and its hard cap
# regardless of activity.
SESSION_IDLE_TIMEOUT=12h
SESSION_ABSOLUTE_TIMEOUT=720h

# Mark the session/CSRF cookies Secure (HTTPS-only). Leave false for local
# HTTP development; set true once the app sits behind TLS.
COOKIE_SECURE=false

# Bootstraps the very first admin account when the users table is empty —
# ignored once any account exists. Required for the first login after a
# clean `docker compose up`; `make env` generates a random password so a
# fresh environment is usable out of the box. Sign in and change it
# immediately — the account is forced to anyway.
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=
